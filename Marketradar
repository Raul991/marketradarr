<script>
/*
  Realtime XAUUSD client.
  - Configurabil endpoint + key
  - Robust fetch cu timeout + backoff
  - Chart + history in localStorage
  - Export/Import CSV
  - Fallback la ultimul preț când API cade
  - Comentarii în română
*/

/* -----------------------
   Utilitare & config
   ----------------------- */

const $ = id => document.getElementById(id);

function clamp(x,a,b){return Math.max(a,Math.min(b,x));}
function fmtPrice(x){ return Number(x).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function nowISO(){ return new Date().toLocaleString(); }
function csvEscape(s){ return '"'+String(s).replace(/"/g,'""')+'"'; }

/* Default config */
const DEFAULT = {
  // Public endpoint that often works for gold spot data; fallback if you set your own
  apiUrl: "https://data-asg.goldprice.org/dbXRates/USD",
  apiKey: "",
  useHeader: false,
  intervalSec: 5,
  timeoutMs: 8000,
  maxPoints: 2000
};

/* Load config from localStorage */
function saveConfig(c){
  localStorage.setItem('xau_cfg', JSON.stringify(c));
}
function loadConfig(){
  try{
    const raw = localStorage.getItem('xau_cfg');
    if(!raw) return {...DEFAULT};
    const parsed = JSON.parse(raw);
    return Object.assign({}, DEFAULT, parsed);
  }catch(e){
    console.warn('cfg parse error',e);
    return {...DEFAULT};
  }
}

let CONFIG = loadConfig();

/* Price history (array of {t:timestamp, price:number}) */
let priceHistory = (function(){
  try{
    const raw = localStorage.getItem('xau_price_history');
    if(!raw) return [];
    const parsed = JSON.parse(raw);
    if(Array.isArray(parsed)) return parsed;
    return [];
  }catch(e){
    console.warn('history parse failed',e);
    return [];
  }
})();

function saveHistory(){
  try{
    localStorage.setItem('xau_price_history', JSON.stringify(priceHistory));
  }catch(e){
    console.warn('saveHistory failed',e);
  }
}

/* -----------------------
   DOM bindings
   ----------------------- */

const elStatus = $('status');
const elPrice = $('price');
const elScore = $('score');
const elRsi = $('rsi');
const elVol = $('vol');
const elDp = $('dp');
const elLast = $('last');
const elSignal = $('signal');
const elReasons = $('reasons');
const elLastRaw = $('lastRaw');

$('apiUrl').value = CONFIG.apiUrl;
$('apiKey').value = CONFIG.apiKey;
$('useHeader').checked = CONFIG.useHeader;
$('interval').value = CONFIG.intervalSec;
$('timeout').value = CONFIG.timeoutMs;
$('maxPoints').value = CONFIG.maxPoints;

/* Clock */
function clock(){
  $('clock').innerText = ' · ' + new Date().toLocaleTimeString();
}
setInterval(clock,1000);
clock();

/* -----------------------
   Chart setup (Chart.js)
   ----------------------- */

const ctx = $('chart').getContext('2d');
let chart = new Chart(ctx, {
  type:'line',
  data:{
    labels: priceHistory.map(p=>new Date(p.t)),
    datasets:[{
      label:'XAUUSD',
      data: priceHistory.map(p=>p.price),
      borderColor:'#6bc957',
      backgroundColor:'rgba(107,201,87,0.06)',
      pointRadius:0,
      borderWidth:2,
      tension:0.15
    }]
  },
  options:{
    animation:false,
    maintainAspectRatio:false,
    scales:{
      x:{ type:'time', time:{unit:'minute', tooltipFormat:'HH:mm:ss'} },
      y:{
        ticks:{color:'#dfefe7'},
        grid:{color:'rgba(20,40,35,0.6)'}
      }
    },
    plugins:{legend:{display:false}}
  }
});

function updateChart(){
  chart.data.labels = priceHistory.map(p=>new Date(p.t));
  chart.data.datasets[0].data = priceHistory.map(p=>p.price);
  chart.update('none');
}

/* -----------------------
   Indicators (SMA/EMA/RSI etc.)
   ----------------------- */

function sma(arr,n){
  if(arr.length<n) return null;
  const s = arr.slice(-n).reduce((a,b)=>a+b,0);
  return s/n;
}

function ema(arr,n){
  if(arr.length<n) return null;
  // classic EMA seeded with SMA
  let e = sma(arr.slice(0,n), n);
  const k = 2/(n+1);
  for(let i=n;i<arr.length;i++){
    e = arr[i]*k + e*(1-k);
  }
  return e;
}

function rsi(arr,n=14){
  if(arr.length < n+1) return 50;
  let gain=0, loss=0;
  for(let i=1;i<=n;i++){
    const d = arr[i]-arr[i-1];
    if(d>0) gain+=d; else loss-=d;
  }
  let avgG = gain/n, avgL = loss/n;
  for(let i=n+1;i<arr.length;i++){
    const d = arr[i]-arr[i-1];
    const g = Math.max(d,0), l=Math.max(-d,0);
    avgG = (avgG*(n-1)+g)/n;
    avgL = (avgL*(n-1)+l)/n;
  }
  if(avgL===0) return 100;
  const rs = avgG/avgL;
  return 100 - (100/(1+rs));
}

function returns(arr){
  const out=[];
  for(let i=1;i<arr.length;i++) out.push(arr[i]-arr[i-1]);
  return out;
}

function volatility(arr){
  const r = returns(arr);
  if(r.length<10) return 0;
  const x = r.slice(-20);
  const mean = x.reduce((a,b)=>a+b,0)/x.length;
  const variance = x.reduce((a,b)=>a+Math.pow(b-mean,2),0)/x.length;
  return Math.sqrt(variance);
}

function momentum(arr,n){
  if(arr.length<n) return 0;
  return arr[arr.length-1] - arr[arr.length-n];
}

/* Radar calculation (similar to original) */
function calculateRadar(price){
  const prices = priceHistory.map(x=>x.price);
  if(prices.length < 30){
    return {
      score:50, rsi:50, ema20:null, ema50:null, ema200:null, volatility:0,
      reasons:["Se colectează istoric XAUUSD...","Ţine pagina deschisă pentru construire indicatori."]
    };
  }

  const ema20 = ema(prices,20), ema50 = ema(prices,50), ema200 = ema(prices,200);
  const RSI = rsi(prices,14), vol = volatility(prices);
  let score = 50, reasons=[];

  if(ema20 && price>ema20){ score+=7; reasons.push("Preţ peste EMA20 → bullish"); } else if(ema20){ score-=7; reasons.push("Preţ sub EMA20 → bearish"); }
  if(ema50 && ema20 && ema20>ema50){ score+=8; reasons.push("EMA20 > EMA50 → trend bullish"); } else if(ema50 && ema20){ score-=8; reasons.push("EMA20 < EMA50 → trend bearish"); }
  if(ema200 && ema50 && ema50>ema200){ score+=8; reasons.push("EMA50 > EMA200 → structură bullish"); } else if(ema200 && ema50){ score-=8; reasons.push("EMA50 < EMA200 → structură bearish"); }
  if(RSI>=55 && RSI<=70){ score+=8; reasons.push("RSI bullish"); } else if(RSI<45){ score-=8; reasons.push("RSI bearish"); } else if(RSI>70){ score-=4; reasons.push("RSI overbought → atenţie"); }
  const m = momentum(prices, Math.min(20, prices.length));
  if(m>0){ score+=7; reasons.push("Momentum pozitiv"); } else { score-=7; reasons.push("Momentum negativ"); }

  score = Math.round(clamp(score,0,100));
  return {score, rsi:RSI, ema20, ema50, ema200, volatility:vol, reasons};
}

/* Map score to label/class */
function signalText(score){
  if(score>=80) return "STRONG BUY";
  if(score>=65) return "BUY";
  if(score<=20) return "STRONG SELL";
  if(score<=35) return "SELL";
  return "WAIT";
}
function signalClass(text){
  if(text.includes("BUY")) return "buy";
  if(text.includes("SELL")) return "sell";
  return "wait";
}

/* -----------------------
   Fetch gold price (flexible parsing)
   - Accepts URL with {apikey} placeholder OR appends ?apikey=... if key provided and no placeholder
   - Optionally sends Authorization: Bearer header
   - Tries to parse multiple common shapes
   ----------------------- */

async function fetchWithTimeout(url, opts = {}, timeoutMs = 8000){
  const controller = new AbortController();
  const id = setTimeout(()=>controller.abort(), timeoutMs);
  opts.signal = controller.signal;
  try{
    const r = await fetch(url, opts);
    const text = await r.text();
    let parsed = null;
    try{ parsed = text ? JSON.parse(text) : null; }catch(e){}
    return {ok:r.ok,status:r.status,statusText:r.statusText, text, json:parsed};
  }finally{ clearTimeout(id); }
}

function buildUrlAndOpts(){
  let url = $('apiUrl').value.trim() || CONFIG.apiUrl;
  const key = $('apiKey').value.trim() || CONFIG.apiKey;
  const useHeader = $('useHeader').checked || CONFIG.useHeader;
  const timeoutMs = Number($('timeout').value) || CONFIG.timeoutMs;

  let opts = {cache:'no-store', headers:{ 'Accept':'application/json' }};

  if(key){
    if(url.includes('{apikey}')){
      url = url.replace(/\{apikey\}/g, encodeURIComponent(key));
    } else if(useHeader){
      opts.headers['Authorization'] = 'Bearer ' + key;
    } else {
      // append query param
      const sep = url.includes('?') ? '&' : '?';
      url = url + sep + 'apikey=' + encodeURIComponent(key);
    }
  }

  return {url, opts, timeoutMs};
}

function parsePriceFromResponse(resp){
  // resp.json may be null; resp.text is string
  const j = resp.json;
  // common shapes:
  // { price: 1950.12 }
  // { rates: { USD: 1950.12 } }
  // { data: { price: ... } }
  // [ { symbol:'XAU', price: 1950 }, ... ]  (metals.live)
  // direct number in text
  if(typeof j === 'number') return j;
  if(j && typeof j.price === 'number') return j.price;
  if(j && typeof j.data === 'object' && typeof j.data.price === 'number') return j.data.price;
  if(j && j.rates && (typeof j.rates.USD === 'number')) return j.rates.USD;
  if(Array.isArray(j) && j.length && typeof j[0].price === 'number') return j[0].price;
  // try some other known key names
  if(j && typeof j.value === 'number') return j.value;
  if(j && typeof j.rate === 'number') return j.rate;
  // try to extract number from text
  const m = resp.text && resp.text.match(/[-+]?\d*\.?\d+/);
  if(m) return Number(m[0]);
  // try deep scan for first number value in JSON
  if(j && typeof j === 'object'){
    try{
      const s = JSON.stringify(j);
      const mm = s.match(/[-+]?\d*\.?\d+/);
      if(mm) return Number(mm[0]);
    }catch(e){}
  }
  return null;
}

/* -----------------------
   Update/render logic
   ----------------------- */

let running = true;
let backoffAttempts = 0;

async function performFetchPrice(){
  const {url, opts, timeoutMs} = buildUrlAndOpts();
  $('lastRaw').value = '';
  try{
    const resp = await fetchWithTimeout(url, opts, timeoutMs);
    $('lastRaw').value = resp.text || ('status: ' + resp.status + ' ' + resp.statusText);
    if(!resp.ok){
      throw new Error('HTTP '+resp.status+' '+resp.statusText);
    }
    const price = parsePriceFromResponse(resp);
    if(price === null || !Number.isFinite(price)) throw new Error('Could not parse price from API response');
    return price;
  }catch(e){
    throw e;
  }
}

function savePoint(price){
  priceHistory.push({t: Date.now(), price: Number(price)});
  const maxP = Number($('maxPoints').value) || CONFIG.maxPoints;
  if(priceHistory.length > maxP) priceHistory = priceHistory.slice(-maxP);
  saveHistory();
  updateChart();
}

function renderAll(price, radar){
  $('price').innerText = '$' + fmtPrice(price);
  $('score').innerText = radar.score + '/100';
  $('rsi').innerText = radar.rsi ? radar.rsi.toFixed(1) : '--';
  $('vol').innerText = radar.volatility ? radar.volatility.toFixed(3) : '--';
  $('dp').innerText = priceHistory.length;
  $('last').innerText = nowISO();
  const sigText = signalText(radar.score);
  $('signal').innerText = sigText;
  $('signal').className = 'sig ' + signalClass(sigText);
  // reasons
  $('reasons').innerHTML = radar.reasons.map(r=>`<div class="small">${r}</div>`).join('');
  $('status').innerText = `● LIVE · ${nowISO()} · ${priceHistory.length} datapoints`;
}

/* Main loop: non-overlapping, with backoff */
async function loopOnce(){
  try{
    const price = await performFetchPrice();
    backoffAttempts = 0;
    savePoint(price);
    const radar = calculateRadar(price);
    renderAll(price, radar);
    CONFIG.apiUrl = $('apiUrl').value.trim();
    CONFIG.apiKey = $('apiKey').value.trim();
    CONFIG.useHeader = $('useHeader').checked;
    saveConfig(CONFIG);
  }catch(err){
    console.error('fetch error', err);
    backoffAttempts++;
    if(priceHistory.length){
      // degraded: use last known price for indicators
      const lastPrice = priceHistory[priceHistory.length-1].price;
      const radar = calculateRadar(lastPrice);
      renderAll(lastPrice, radar);
      $('status').innerText = `⚠️ Degraded · folosind ultimul preț · ${err.message}`;
    } else {
      $('status').innerText = '🔴 Feed error: ' + err.message;
    }
  }
}

/* Controlled loop with interval and exponential backoff when errors happen */
let loopHandle = null;
async function startLoop(){
  if(loopHandle) return;
  running = true;
  $('toggleLive').innerText = 'Pause';
  const baseInterval = Math.max(1000, (Number($('interval').value) || CONFIG.intervalSec) * 1000);
  while(running){
    const start = Date.now();
    await loopOnce();
    const elapsed = Date.now() - start;
    let wait = Math.max(1000, baseInterval - elapsed);
    // backoff if repeated failures
    if(backoffAttempts > 0){
      wait = Math.min(60000, wait * Math.pow(1.8, backoffAttempts));
    }
    await new Promi
